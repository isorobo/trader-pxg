COINGECKO_API_KEY=

# --- Phase 5 ops setup (05-08-PLAN.md) --------------------------------------
# IBKR paper connection via IB Gateway (standing rule 6: paper port 4002 only,
# never 4001). IBKR_HOST defaults to 127.0.0.1 in trader/paper/config.py --
# only set it if Gateway runs on a different host.
IBKR_HOST=127.0.0.1
# Any small integer not already in use by another Gateway API client.
IBKR_CLIENT_ID=5

# Telegram alerts (D-11): create via @BotFather's /newbot flow, then message
# the new bot once so TELEGRAM_CHAT_ID can be resolved via getUpdates.
TELEGRAM_BOT_TOKEN=your-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Kraken read-only sanity check (D-04) -- optional, never used for order
# placement in Phase 5.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
