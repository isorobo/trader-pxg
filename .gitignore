# Secrets — never committed (standing rule 3)
.env
.env.*
!.env.example
*.key
secrets/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Data — local databases and raw snapshots stay out of git
*.sqlite
*.sqlite3
*.db
/data/

# Generated daily reports — regenerated by report.py, not tracked (D-12)
reports/

# Rotating ops log — runtime output of trader.paper.ops_log, not tracked (D-12)
ops/

# OS / editor
.DS_Store
Thumbs.db

# IB Gateway install: a vendor binary distribution that lives inside the
# repo folder. It carries launcher logs and per-user session/settings
# files (jts.ini holds the account's directory mapping), so it must never
# reach a public remote -- and it is reinstallable in one download.
ibgateway/
